# Copy this file to ".env.local" and fill in your Supabase project's values.
# Supabase dashboard → Project Settings → API.
# The anon key is a PUBLIC client key (safe in a frontend); row-level security
# is what actually protects each user's data. Never put the service_role key here.

VITE_SUPABASE_URL=https://YOURPROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...
